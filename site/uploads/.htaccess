# Uploaded photos only. Nothing in this folder may run as a script.
Options -Indexes -ExecCGI
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|inc|pl|py|cgi|sh|asp|aspx|jsp|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
