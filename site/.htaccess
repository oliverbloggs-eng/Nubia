# Nubia KC Estates — Apache settings (Hostinger, public_html)
Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# One address for the whole site: https://nubiakcestates.com
# (sends http://, www. and any other domain pointed here, permanently;
# the system subdomain is left alone and forces HTTPS itself)
RewriteCond %{HTTP_HOST} !^nubiakcestates\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !\.test$ [NC]
RewriteCond %{HTTP_HOST} !^system\.nubiakcestates\.com$ [NC]
RewriteRule ^ https://nubiakcestates.com%{REQUEST_URI} [L,R=301]
# Add trailing slash to page folders (/about -> /about/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [L,R=301]
# Keep internal files out of search
RewriteRule ^source/ - [F,L]
# Shared PHP code and the deploy's record files are never served
RewriteRule ^inc/ - [F,L]
RewriteRule ^\.ftp-deploy - [F,L]
# Listings from the database: a page per listing, the sitemap and the app's data
RewriteRule ^property/([a-z0-9-]+)/$ /property/$1 [L,R=301]
RewriteRule ^property/([a-z0-9-]+)$ property/index.php?slug=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^listings\.json$ property/index.php?format=json [L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
<FilesMatch "app\.html$">
Header set X-Robots-Tag "noindex"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/json "access plus 0 seconds"
ExpiresByType application/xml "access plus 0 seconds"
ExpiresByType text/css "access plus 1 week"
ExpiresByType application/javascript "access plus 1 week"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/webp .webp
